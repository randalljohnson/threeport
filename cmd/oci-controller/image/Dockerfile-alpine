# generated by 'threeport-sdk gen' but will not be regenerated - can optionally be edited
FROM golang:1.24-alpine AS builder
ARG PULUMI_VERSION=3.198.0
RUN apk add --no-cache ca-certificates curl
RUN curl -fsSL https://get.pulumi.com | sh -s -- --version ${PULUMI_VERSION}

FROM golang:1.24-alpine
COPY bin/oci-controller /oci-controller
COPY --from=builder /root/.pulumi/bin/pulumi* /usr/local/bin/
RUN mkdir -p /threeport-state && chown 65532:65532 /threeport-state
ENV HOME=/.threeport
USER 65532:65532
ENTRYPOINT ["/oci-controller"]
