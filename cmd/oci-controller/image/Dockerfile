WORKDIR /build
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${ARCH} go build -a -o oci-controller cmd/oci-controller/main_gen.go
RUN CGO_ENABLED=0 go build -o /wait-for-tcp cmd/wait-for-tcp/main.go

